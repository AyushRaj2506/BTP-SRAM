M1 Qb Q Vdd Vdd SRAM_PMOS_STORAGE_DRIFT l=180nm w=360nm
M2 Q Qb Vdd Vdd SRAM_PMOS_STORAGE_DRIFT l=180nm w=360nm
M3 Q Qb 0 0 SRAM_NMOS_STORAGE_DRIFT l=180nm w=720nm
M4 Qb Q 0 0 SRAM_NMOS_STORAGE_DRIFT l=180nm w=720nm
M5 Q WL BL 0 SRAM_NMOS l=180nm w=540nm
M6 Qb WL BLB 0 SRAM_NMOS l=180nm w=540nm
Cq  Qb 0 1fF
Cqb Q  0 1fF
.model NMOS NMOS
.model PMOS PMOS
.model SRAM_NMOS NMOS (LEVEL=1 VTO=0.45 KP=250u GAMMA=0.4 LAMBDA=0.08 PHI=0.7 TOX=4n)
.model SRAM_NMOS_STORAGE_DRIFT NMOS (LEVEL=1 VTO=0.495 KP=250u GAMMA=0.4 LAMBDA=0.08 PHI=0.7 TOX=4n)
.model SRAM_PMOS PMOS (LEVEL=1 VTO=-0.45 KP=100u GAMMA=0.4 LAMBDA=0.1 PHI=0.7 TOX=4n)
.model SRAM_PMOS_STORAGE_DRIFT PMOS (LEVEL=1 VTO=-0.495 KP=100u GAMMA=0.4 LAMBDA=0.1 PHI=0.7 TOX=4n)
